{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Stay on Python <=3.14 for CI images: prometheus.prometheus 0.30.x caps ansible-core at 2.21.x, which does not support 3.15. Includes minor bumps because 3.14 -> 3.15 is a minor update. Revisit once the collection supports ansible-core 2.22+.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ],
  "docker-compose": {
    "managerFilePatterns": ["/(^|/)docker-compose\\.ya?ml\\.j2$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)roles/kubernetes_flux/defaults/main\\.ya?ml$/"],
      "matchStrings": [
        "kubernetes_flux_cli_version:\\s*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "fluxcd/flux2",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ]
}
