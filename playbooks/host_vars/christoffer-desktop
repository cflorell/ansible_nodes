---
# The only host here that escalates over SSH (the rest connect as root), and
# without pipelining every become times out waiting for a sudo prompt that
# never reaches Ansible. Pipelining passes the module and the become password
# over the open stdin stream instead of a separate PTY-backed call, which
# avoids the prompt handshake entirely. Safe because no host sets requiretty.
ansible_pipelining: true

llama_server: true
llama_backend: vulkan

# Two models behind llama-swap, picked per request rather than one fixed
# model: whichever is requested loads on demand and the other unloads, so
# both can be offered without holding both in VRAM at once (16 GB cannot fit
# both anyway - 9 GB + 5 GB of weights alone leaves no room for KV cache).
# Loaded models are freed after an hour of disuse (llama_model_ttl below) so
# an idle desktop is not left holding either one in VRAM indefinitely.
llama_model_ttl: 3600
llama_models:
  # Best quality, native 32768 context. Good default for chat via Open WebUI.
  - id: qwen3-14b
    repo: "unsloth/Qwen3-14B-GGUF:Q4_K_M"
    context_size: 32768
    extra_args:
      - "--cache-type-k"
      - "q8_0"
      - "--cache-type-v"
      - "q8_0"
      # Exposes this model's own /metrics (tokens/s, KV cache utilisation,
      # queue depth) at GET /upstream/qwen3-14b/metrics on llama-swap's port,
      # for manual curl-based checks. Not scraped by Prometheus: that would
      # force this model to load on every scrape, evicting whichever model
      # was actually in use. See the comment in prometheus.yml.j2.
      - "--metrics"

  - id: qwen3-8b
    repo: "unsloth/Qwen3-8B-GGUF:Q4_K_M"
    context_size: 65536
    extra_args:
      - "--cache-type-k"
      - "q8_0"
      - "--cache-type-v"
      - "q8_0"
      - "--rope-scaling"
      - "yarn"
      - "--rope-scale"
      - "4"
      - "--yarn-orig-ctx"
      - "32768"
      # See the qwen3-14b comment above: manual-inspection-only, same reason.
      - "--metrics"

# node_exporter plus the amdgpu sysfs collector (roles/node_exporter_atomic),
# scraped by prometheus-grafana. This host is a workstation and is off much
# of the time, so its targets are expected to be down; no alert rule watches
# them.
node_exporter: true
