---
nfs_client: true
nfs_server: false

docker: true

# Optional person-to-album sync. Immich's People view is a face cluster, not an
# album, so an album has to be populated separately. This service adds a
# person's assets to an existing album and keeps it current.
#
# Each job becomes a separate user entry in the container config, so one
# container can sync several accounts with different API keys. Use the person
# ID from the account that owns the key. Set the keys in
# group_vars/all/secrets.sops.yaml under immich_person_album_api_keys.
immich_person_album_enabled: true
immich_person_album_schedule: "*/30 * * * *"
immich_person_album_jobs:
  - description: "Kid (main account)"
    api_key_name: admin
    person_id: "3acd64f6-fcad-415e-9295-9223a66f8850"
    album_id: "d3ee16db-d90a-44f1-b3bf-0dc56399fef1"
  - description: "Kid (other account)"
    api_key_name: other
    person_id: "3acd64f6-fcad-415e-9295-9223a66f8850"
    album_id: "d3ee16db-d90a-44f1-b3bf-0dc56399fef1"

# Service registry — consumed by the gatus/homepage/homelable-canvas templates
# on the docker host. Schema documented in host_vars/docker.
services:
  - name: immich-server
    port: 2283
    check: http
    interval: 2m
    canvas:
      label: immich_server
      icon: brand:immich
      notes: >-
        Immich server — photo library API and web UI.
    homepage:
      name: Immich
      group: Home
      icon: immich.png
      description: Photo library
      widget:
        type: immich
        key: "{{ immich_api_key | default('changeme') }}"
        version: 2
      extra:
        proxmoxNode: proxmox2
        proxmoxVMID: 102
        proxmoxType: lxc

  - name: immich-person-to-album
    check: none
    canvas:
      label: immich_person_album
      icon: sync
      notes: >-
        Optional person-to-album sync; runs only while the integration is
        enabled.

  - name: immich-machine-learning
    check: none
    canvas:
      label: immich_machine_learning
      icon: bot
      notes: >-
        Immich ML worker — face recognition and CLIP search embeddings.

  - name: immich-postgres
    check: none
    canvas:
      label: immich_postgres
      icon: brand:postgresql
      notes: >-
        pgvecto-rs (PostgreSQL 14 with vector search) — Immich's database.

  - name: immich-redis
    check: none
    canvas:
      label: immich_redis
      icon: brand:redis
      notes: >-
        Redis — Immich job queue.
