#!/bin/bash
# {{ ansible_managed }}
#
# Return unused blocks from Proxmox guests so LVM-thin pools and other
# thin-provisioned storage do not fill up with deleted-but-untrimmed data.
#
# Containers are trimmed with `pct fstrim`, which mounts the volume on the
# host and runs fstrim against its rootfs and non-bind mountpoints. Running
# VMs are asked to trim through the QEMU guest agent; VM blocks only reach the
# storage when the disk is on virtio-scsi/virtio-blk with discard=on (QEMU's
# SATA/IDE controller does not pass ATA TRIM).
set -uo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

failures=0

echo "== Container trim =="
while read -r vmid; do
    echo "-- CT ${vmid} --"
    if ! timeout "{{ proxmox_fstrim_timeout }}" pct fstrim "${vmid}"; then
        echo "WARNING: pct fstrim failed for CT ${vmid}" >&2
        failures=$((failures + 1))
    fi
done < <(pct list | awk 'NR > 1 && $2 == "running" { print $1 }')

{% if proxmox_fstrim_vms %}
echo "== VM trim =="
while read -r vmid; do
    # Do not let a stopped/unresponsive agent block the rest of the run.
    if ! timeout 10 qm agent "${vmid}" ping >/dev/null 2>&1; then
        echo "-- VM ${vmid}: guest agent not available, skipping --"
        continue
    fi
    echo "-- VM ${vmid} --"
    if ! timeout "{{ proxmox_fstrim_timeout }}" qm guest cmd "${vmid}" fstrim; then
        echo "WARNING: guest fstrim failed for VM ${vmid}" >&2
    fi
done < <(qm list | awk 'NR > 1 && $3 == "running" { print $1 }')
{% endif %}

if [ "${failures}" -gt 0 ]; then
    echo "WARNING: ${failures} container trim(s) failed" >&2
    exit 1
fi
