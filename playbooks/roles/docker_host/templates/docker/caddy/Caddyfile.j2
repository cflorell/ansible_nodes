{
    # rate_limit ships in a third-party module, so its place in the middleware
    # chain is not known to Caddy and has to be stated. Ahead of the auth
    # directives, so a flood is rejected before any credential is checked.
    order rate_limit before basicauth
}

*.{{ porkbun_domain }} {
    tls {
        dns porkbun {
            api_key {{ porkbun_api_key }}
            api_secret_key {{ porkbun_secret_api_key }}
        }
    }
{% for site in caddy_reverse_proxies %}

    @{{ site.host }} host {{ site.host }}.{{ porkbun_domain }}
    handle @{{ site.host }} {
{% if site.forward_auth | default(false) %}
        # Authentik forward auth via the embedded outpost. The callback path
        # must reach the outpost directly and unauthenticated; everything else
        # is authorized by it before reaching the upstream.
        reverse_proxy /outpost.goauthentik.io/* {{ caddy_upstream_authentik_outpost }}

        forward_auth {{ caddy_upstream_authentik_outpost }} {
            uri /outpost.goauthentik.io/auth/caddy
            copy_headers X-authentik-username X-authentik-groups X-authentik-email X-authentik-name X-authentik-uid X-authentik-jwt X-authentik-meta-jwks X-authentik-meta-outpost X-authentik-meta-provider X-authentik-meta-app X-authentik-meta-version
        }

{% endif %}
{% if site.rate_limit is defined %}
        # Throttles this host's credential-checking endpoints per client
        # address. Scoped to those paths so ordinary browsing and media
        # streaming are untouched. Exceeding the limit returns 429.
        @{{ site.host }}_rl path {{ site.rate_limit.paths | join(' ') }}
        rate_limit @{{ site.host }}_rl {
            zone {{ site.host }}_login {
                key {remote_host}
                events {{ site.rate_limit.events }}
                window {{ site.rate_limit.window }}
            }
        }

{% endif %}
{% if site.insecure_skip_verify | default(false) %}
        reverse_proxy {{ site.upstream }} {
            transport http {
                tls_insecure_skip_verify
            }
        }
{% else %}
        reverse_proxy {{ site.upstream }}
{% endif %}
    }
{% endfor %}
}

{{ caddy_duckdns_host }} {
    reverse_proxy {{ caddy_upstream_homeassistant }}
}
