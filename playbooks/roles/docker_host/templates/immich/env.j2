# You can generate a secret with: openssl rand -base64 128
DB_PASSWORD={{ immich_db_password }}

DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_DATA_LOCATION=./postgres/

UPLOAD_LOCATION={{ storage_disks.disk3.path }}/immich
IMMICH_VERSION=v3.0.3

# Declares immich-config.json as the source of truth for system settings,
# which is what carries the OIDC configuration. The admin UI turns read-only
# while this is set; change settings in the template, not in the browser.
IMMICH_CONFIG_FILE=/config/immich-config.json
