AUTHENTIK_SECRET_KEY={{ authentik_secret_key }}

# Bootstrap credentials for the built-in akadmin account. These are applied
# only while Authentik initializes a fresh database; on an already-initialized
# instance they have no effect. Setting the password here rather than relying
# on the interactive initial-setup (OOBE) flow keeps first login deterministic
# and reproducible from a wipe.
#
# To reset the password on an instance that is already initialized, run on the
# authentik host:
#   docker compose run --rm server change_password akadmin
AUTHENTIK_BOOTSTRAP_PASSWORD={{ authentik_bootstrap_password }}
AUTHENTIK_BOOTSTRAP_EMAIL={{ authentik_bootstrap_email | default('akadmin@' ~ porkbun_domain) }}

# API token consumed by the authentik/ Terraform project in terraform_nodes,
# which manages groups, providers, applications and policy bindings. The same
# value is stored there, so both secret stores agree. Created alongside the
# credentials above, under the same fresh-database condition.
AUTHENTIK_BOOTSTRAP_TOKEN={{ authentik_bootstrap_token }}

# Caddy on the docker host is the only proxy in front of Authentik. Trusting
# that host alone means forwarded client addresses are honoured from it and
# nowhere else, so event logs and IP-based policies record real client
# addresses rather than the proxy's.
AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS={{ docker_server_ip }}/32

# AUTHENTIK_COOKIE_DOMAIN is deliberately unset. Setting it to the apex domain
# scopes the session cookie to *.{{ porkbun_domain }}, which makes Authentik
# unreachable by LAN IP: a browser discards a domain-scoped cookie when the
# request host is a bare address, so the login flow loses its state and
# restarts instead of advancing to the password stage. Direct IP access is the
# escape hatch for when Caddy or DNS is broken, so it is kept working.
#
# Proxy providers use forward_auth_mode "single", where each protected host
# carries its own outpost cookie and single sign-on works by redirecting to
# auth.{{ porkbun_domain }}, which holds its own session. A cookie domain is
# only required for domain-level forward auth. Revisit this only if
# cross-application sign-on turns out to need it.
