---
# Consumed by Flux's kustomize-controller: a Secret named `sops-age` in the
# flux-system namespace, with a data key suffixed `.agekey`, referenced from
# each Kustomization's spec.decryption block in the GitOps repo.
apiVersion: v1
kind: Secret
metadata:
  name: sops-age
  namespace: {{ kubernetes_flux_namespace }}
type: Opaque
stringData:
  age.agekey: "{{ kubernetes_flux_age_key }}"
