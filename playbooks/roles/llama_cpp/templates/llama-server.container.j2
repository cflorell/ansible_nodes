# {{ ansible_managed }}
# Podman Quadlet: systemd generates llama-server.service from this file on
# `systemctl daemon-reload`. Podman is used rather than Docker because it ships
# with the host image; nothing has to be layered on to run this.
#
# Runs llama-swap rather than llama-server directly: it fronts every model in
# llama_models behind this one port, loading whichever one a client requests
# and swapping to a different one on demand. See llama_swap_image in
# defaults/main.yml for why "unified".
[Unit]
Description=llama-swap inference proxy ({{ llama_backend }})
After=network-online.target
Wants=network-online.target

[Container]
ContainerName={{ llama_service_name }}
Image={{ llama_swap_image }}
PublishPort={{ llama_listen_address }}:{{ llama_port }}:8080
Volume={{ llama_cache_dir }}:/root/.cache/llama.cpp
Volume={{ llama_swap_config_dir }}/config.yaml:/etc/llama-swap/config/config.yaml:ro
Environment=LLAMA_CACHE=/root/.cache/llama.cpp
{% if llama_backend == "rocm" and llama_rocm_gfx_override %}
Environment=HSA_OVERRIDE_GFX_VERSION={{ llama_rocm_gfx_override }}
{% endif %}
{% for device in llama_devices -%}
AddDevice={{ device }}
{% endfor -%}
# The GPU device nodes carry host labels, not container ones, so an enforcing
# SELinux denies the container access to them until labelling is switched off
# for this container.
SecurityLabelDisable=true

[Service]
# Unlike the old single-model setup, the container itself starts in seconds:
# no model loads until a client requests one, so this only has to cover
# llama-swap's own startup, not a weights download. That wait is covered by
# healthCheckTimeout in config.yaml instead.
TimeoutStartSec=120
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
